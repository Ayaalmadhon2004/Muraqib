{
  "name": "muraqib",
  "type": "module",
  "version": "1.0.0",
  "description": "Developer Environment Guardian & Performance Auditor — comprehensive audit suite for Node.js projects with 13+ modules",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "dev-server": "npm --prefix examples/express-prisma run dev",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "audit": "tsx src/index.ts --url http://localhost:3000 --security-url http://localhost:3000 --silent",
    "audit:ci": "tsx scripts/collect-audit.ts",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ayaalmadhon2004/Muraqib.git"
  },
  "keywords": [
    "audit",
    "environment",
    "performance",
    "validation",
    "bundle-size",
    "security",
    "nodejs",
    "typescript"
  ],
  "author": "Aya Almadhon <aya.alaasel123@gmail.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Ayaalmadhon2004/Muraqib/issues"
  },
  "homepage": "https://github.com/Ayaalmadhon2004/Muraqib#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "src/**/*.d.ts.map",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "devDependencies": {
    "@types/node": "^25.9.9",
    "@types/semver": "^7.7.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^9.39.5",
    "sharp": "^0.35.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "@google/genai": "^2.22.0",
    "arktype": "^2.2.0",
    "axios": "^1.17.0",
    "chalk": "^5.6.2",
    "cron-parser": "^5.5.0",
    "glob": "^13.0.6",
    "ignore": "^7.0.10",
    "semver": "^7.8.2",
    "valibot": "^1.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.4.3"
  }
}
